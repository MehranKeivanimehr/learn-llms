---
import { getCollection, render } from 'astro:content';
import ArcadeLevel from '../../arcade/ArcadeLevel';
import ArcadeLayout from '../../layouts/ArcadeLayout.astro';
import { sortLevels, toLevelInfo } from '../../lib/levels';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = sortLevels(await getCollection('levels'));
  const all = entries.map(toLevelInfo);
  return entries.map((entry, i) => ({ params: { slug: all[i].slug }, props: { entry, level: all[i], all } }));
}

const { entry, level, all } = Astro.props;
const { Content } = await render(entry);
---
<ArcadeLayout title={level.title} description={level.summary}>
  <div id="lesson" hidden><Content /></div>
  <ArcadeLevel client:load level={level} levels={all} homeHref={withBase('')} trackHref={withBase('inside/')} />
</ArcadeLayout>
