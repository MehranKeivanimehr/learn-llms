---
import { getCollection, render } from 'astro:content';
import LevelShell from '../../engine/LevelShell.astro';
import Layout from '../../layouts/Layout.astro';
import { sortLevels, toLevelInfo } from '../../lib/levels';

export async function getStaticPaths() {
  const entries = sortLevels(await getCollection('levels'));
  const all = entries.map(toLevelInfo);
  return entries.map((entry, i) => ({
    params: { slug: all[i].slug },
    props: { entry, level: all[i], prev: all[i - 1] ?? null, next: all[i + 1] ?? null, all },
  }));
}

const { entry, level, prev, next, all } = Astro.props;
const { Content } = await render(entry);
---
<Layout title={level.title} description={level.summary}>
  <LevelShell level={level} prev={prev} next={next} all={all}>
    <Content />
  </LevelShell>
</Layout>
